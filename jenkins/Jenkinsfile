pipeline {
    agent {
        docker {
            image 'node:18-alpine'  // Using a specific version is better than ^18.0.0
            args '-p 3000:3000 -u root --network jenkins -v ${WORKSPACE}:/workspace'  // Added workspace mounting
        }
    }
    environment {
        CI = 'true'
        NODE_OPTIONS = '--openssl-legacy-provider'
        HOME = '.'  // Ensure npm/pnpm can write to the current directory
    }
    stages {
        stage('Clean Workspace') {
            steps {
                // Using shell commands instead of cleanWs()
                sh 'rm -rf *'
            }
        }
        stage('Checkout') {
            steps {
                checkout([
                    $class: 'GitSCM',
                    branches: [[name: '*/react-app']],
                    extensions: [
                        [$class: 'CleanBeforeCheckout'],
                        [$class: 'CleanCheckout']
                    ],
                    userRemoteConfigs: [[
                        // Use the absolute path or preferably a proper Git URL
                        url: 'file:///home/learning/devops/cicd-labs'
                    ]]
                ])
            }
        }
        stage('Build') {
            steps {
                sh '''
                    # Install pnpm if not available
                    if ! command -v pnpm &> /dev/null; then
                        npm install -g pnpm
                    fi
                    echo "Node version: $(node -v)"
                    echo "PNPM version: $(pnpm -v)"
                    pnpm install
                '''
            }
        }
        stage('Test') {
            steps {
                sh '''
                    # Update Babel dependencies if needed
                    pnpm add -D @babel/core@^7.22.0 @babel/plugin-syntax-import-attributes@^7.22.0
                    
                    # Run tests with CI=true to avoid watch mode
                    CI=true pnpm test -- --passWithNoTests
                '''
            }
        }
        stage('Deliver') {
            steps {
                sh '''
                    chmod +x ./jenkins/scripts/deliver.sh
                    ./jenkins/scripts/deliver.sh
                '''
                input message: 'Finished using the website? (Click "Proceed" to continue)'
                sh '''
                    chmod +x ./jenkins/scripts/kill.sh
                    ./jenkins/scripts/kill.sh
                '''
            }
        }
    }
    post {
        always {
            // Using shell commands instead of cleanWs()
            sh 'rm -rf *'
        }
    }
}