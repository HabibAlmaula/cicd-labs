pipeline {
    agent any
    environment {
        CI = 'true'
        NODE_OPTIONS = '--openssl-legacy-provider'
    }
    stages {
        stage('Clean Workspace') {
            steps {
                cleanWs()
            }
        }
        stage('Checkout') {
            steps {
                checkout([
                    $class: 'GitSCM',
                    branches: [[name: '*/react-app']], // Using react-app branch
                    extensions: [
                        [$class: 'CleanBeforeCheckout'],
                        [$class: 'CleanCheckout']
                    ],
                    userRemoteConfigs: [[
                        url: '/home/learning/devops/cicd-labs'
                    ]]
                ])
                // Verify contents after checkout
                sh 'ls -la'
                sh 'pwd'
            }
        }
        stage('Build') {
            steps {
                sh '''
                    echo "Current directory contents:"
                    ls -la
                    echo "Node version:"
                    node -v
                    echo "PNPM version:"
                    pnpm -v
                    pnpm install
                '''
            }
        }
        stage('Test') {
            steps {
                sh '''
                    chmod +x ./jenkins/scripts/test.sh
                    ./jenkins/scripts/test.sh
                '''
            }
        }
        stage('Deliver') {
            steps {
                sh '''
                    chmod +x ./jenkins/scripts/deliver.sh
                    ./jenkins/scripts/deliver.sh
                '''
                input message: 'Finished using the website? (Click "Proceed" to continue)'
                sh '''
                    chmod +x ./jenkins/scripts/kill.sh
                    ./jenkins/scripts/kill.sh
                '''
            }
        }
    }
    post {
        always {
            cleanWs()
        }
    }
}