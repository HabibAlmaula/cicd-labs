pipeline {
    agent {
        docker {
            image 'node:18-buster-slim'
            args '-p 3000:3000'
        }
    }
    environment {
        CI = 'true'
        // Use a local directory for pnpm installation
        PNPM_HOME = '/tmp/pnpm'
        PATH = "${env.PNPM_HOME}:${env.PATH}"
    }
    stages {
        stage('Setup PNPM') {
            steps {
                // Install pnpm using corepack (available in Node.js 16+)
                sh '''
                    corepack enable
                    corepack prepare pnpm@latest --activate
                    pnpm setup
                    echo "Node version: $(node -v)"
                    echo "PNPM version: $(pnpm -v)"
                '''
            }
        }
        stage('Build') {
            steps {
                sh 'pnpm install'
            }
        }
        stage('Test') {
            steps {
                sh '''
                    chmod +x ./jenkins/scripts/test.sh
                    ./jenkins/scripts/test.sh
                '''
            }
        }
        stage('Deliver') {
            steps {
                sh '''
                    chmod +x ./jenkins/scripts/deliver.sh
                    ./jenkins/scripts/deliver.sh
                '''
                input message: 'Finished using the website? (Click "Proceed" to continue)'
                sh '''
                    chmod +x ./jenkins/scripts/kill.sh
                    ./jenkins/scripts/kill.sh
                '''
            }
        }
    }
}